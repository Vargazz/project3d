{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=project3d;Username=project3d_user;Password=project3d_pass"
  },
  "Jwt": {
    "SecretKey": "TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_MINIMO_32_CHARS",
    "Issuer": "project3d-api",
    "Audience": "project3d-client",
    "ExpiresInMinutes": 60,
    "RefreshExpiresInDays": 7
  },
  "MercadoPago": {
    "AccessToken": "",
    "PublicKey": "",
    "WebhookSecret": "",
    "BaseUrl": "https://api.mercadopago.com",
    "NotificationUrl": "http://localhost:5000/api/payments/webhook",
    "SuccessUrl": "http://localhost:4200/pedido/sucesso",
    "FailureUrl": "http://localhost:4200/pedido/falha",
    "PendingUrl": "http://localhost:4200/pedido/pendente"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Upload": {
    "UseLocal": true,
    "LocalPath": "uploads",
    "MaxFileSizeMb": 10,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
